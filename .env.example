DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production
# Netlify reserves AWS_* and fills them with its own credentials. Set these four there.
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_REGION=us-east-2
# Local `neon env pull` writes the same values under the AWS names. Leave them unset on Netlify.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
AUTH_EMAIL=owner@localhost
AUTH_PASSWORD=change-me-now
AUTH_SECRET=replace-with-a-long-random-string
RATE_LIMIT_PER_MINUTE=120
